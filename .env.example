# --- Required ---
TELEGRAM_BOT_TOKEN=123456789:AA...        # from @BotFather
OWNER_ID=123456789                        # your Telegram ID (ask @userinfobot)
GROQ_API_KEY=gsk_...                      # console.groq.com → API Keys

# --- Fallback LLM (optional) ---
GEMINI_API_KEY=                           # aistudio.google.com → Get API key
GEMINI_MODEL=gemini-2.5-flash-lite        # check the current model name in AI Studio

# --- Groq models (check current names at console.groq.com/docs/models) ---
GROQ_MODEL=openai/gpt-oss-120b
WHISPER_MODEL=whisper-large-v3-turbo

# --- Learning ---
LEVEL=A2-B1
INTERESTS=art, medicine, psychology
NATIVE_LANGUAGE=Russian                   # language for translations and mistake explanations
UI_LANG=ru                                # bot interface language: ru / en

# --- Schedule ---
TIMEZONE=Europe/Moscow                   # your time zone (IANA)
DIGEST_TIME=08:00
DIGEST_SIZE=5
REVIEW_DAY=sun
REVIEW_TIME=11:00

# --- Voice ---
VOICE_REPLIES=1
TTS_VOICE=en-US-AriaNeural
TTS_RATE=-5%

# --- Content ---
FEEDS_FILE=feeds.txt
MAX_AGE_HOURS=48
PODCAST_MAX_MB=9

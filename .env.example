# --- Обязательно ---
TELEGRAM_BOT_TOKEN=123456789:AA...        # от @BotFather
OWNER_ID=123456789                        # ваш Telegram ID (узнать у @userinfobot)
GROQ_API_KEY=gsk_...                      # console.groq.com → API Keys

# --- Запасная LLM (необязательно) ---
GEMINI_API_KEY=                           # aistudio.google.com → Get API key
GEMINI_MODEL=gemini-2.5-flash-lite        # проверьте актуальное имя модели в AI Studio

# --- Модели Groq (проверьте актуальные имена в console.groq.com/docs/models) ---
GROQ_MODEL=openai/gpt-oss-120b
WHISPER_MODEL=whisper-large-v3-turbo

# --- Обучение ---
LEVEL=A2-B1
INTERESTS=art, medicine, psychology
NATIVE_LANGUAGE=Russian                   # язык переводов и объяснений ошибок
UI_LANG=ru                                # язык интерфейса бота: ru / en

# --- Расписание ---
TIMEZONE=Europe/Moscow                   # ваш часовой пояс (IANA)
DIGEST_TIME=08:00
DIGEST_SIZE=5
REVIEW_DAY=sun
REVIEW_TIME=11:00

# --- Озвучка ---
VOICE_REPLIES=1
TTS_VOICE=en-US-AriaNeural
TTS_RATE=-5%

# --- Контент ---
FEEDS_FILE=feeds.txt
MAX_AGE_HOURS=48
PODCAST_MAX_MB=9
